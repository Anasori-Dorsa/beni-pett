# ---------- سرور ----------
PORT=4000
NODE_ENV=development

# آدرس عمومی خود بک‌اند (که از بیرون قابل دسترسیه)، فقط برای callback زیبال لازمه.
# روی لوکال‌هاست معمولاً با یک تانل مثل ngrok پرش می‌کنید؛ مثال:
# BACKEND_PUBLIC_URL=https://abcd1234.ngrok-free.app
BACKEND_PUBLIC_URL=http://localhost:4000

# آدرس دقیق فرانت‌اند (بدون اسلش انتهایی). هم برای CORS هم برای ریدایرکت نهایی بعد پرداخت زیبال استفاده می‌شه.
CORS_ORIGIN=http://localhost:3000

# آدرس عمومی که فایل‌های آپلودی (عکس محصولات) ازش سرو می‌شن. روی لوکال معمولاً همون آدرس خود بک‌اند.
UPLOAD_PUBLIC_BASE_URL=http://localhost:4000

# ---------- دیتابیس MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=beni_pett_user
DB_PASSWORD=change_this_password
DB_NAME=beni_pett
DB_CONNECTION_LIMIT=10

# ---------- احراز هویت ----------
# یک رشته‌ی طولانی و تصادفی بسازید، مثلاً با: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# ---------- پیامک (OTP) ----------
# dev = فقط در کنسول سرور چاپ می‌شه (رایگان، برای تست). kavenegar = ارسال واقعی.
SMS_MODE=dev
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ---------- درگاه پرداخت زیبال ----------
# "zibal" مرچنت sandbox پیش‌فرض زیباله (نیازی به ثبت‌نام نداره، برای تست کافیه).
# برای پرداخت واقعی، مرچنت‌کد واقعی خودتون رو از پنل زیبال جایگزین کنید.
ZIBAL_MERCHANT=zibal

# ---------- کپچا (اختیاری، غیرفعال به‌صورت پیش‌فرض) ----------
CAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
# یا اگه از Turnstile استفاده می‌کنید:
TURNSTILE_SECRET_KEY=
